---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Stories | MGCE">
	<Navbar />

	<!-- Hero with Video Background -->
	<section class="hero about-hero position-relative text-white d-flex align-items-center justify-content-center">
	<!-- Video Background -->
	<video autoplay muted loop playsinline class="hero-video">
		<source src="/assets/video/g3.mp4" type="video/mp4">
		Your browser does not support the video tag.
	</video>

	<!-- Gradient Overlay -->
	<div class="hero-overlay"></div>

	<!-- Content -->
	<div class="container position-relative text-center" style="z-index: 2;">
		<h1 class="display-4 fw-bold">Stories of Impact</h1>
		<p class="lead">Real voices. Real change. From Maseno to the world.</p>
	</div>
	</section>


	<!-- Filter Buttons -->
	<section class="py-4 text-center filter-section">
	<div class="container">
		<button class="btn btn-outline-primary filter-btn active" data-filter="all">All</button>
		<button class="btn btn-outline-primary filter-btn" data-filter="mentorship">Mentorship</button>
		<button class="btn btn-outline-primary filter-btn" data-filter="leadership">Leadership</button>
		<button class="btn btn-outline-primary filter-btn" data-filter="education">Education</button>
	</div>
	</section>

	<!-- Story Cards -->
	<section class="py-5 story-grid">
	<div class="container">
		<div class="row g-4" id="storyContainer">
		<!-- Cards injected by JS -->
		</div>
	</div>
	</section>

	<!-- Quote Carousel -->
	<section class="py-5 quote-carousel text-center">
	<div class="container">
		<h2 class="text-pink mb-4">What Girls Say</h2>
		<p id="quoteDisplay" class="lead">“MGCE helped me find my voice.”</p>
	</div>
	</section>

	<!-- Impact Counters -->
	<section class="py-5 text-center bg-white impact-section shadow-sm">
	<div class="container py-4">
		<h2 class="text-pink mb-4 display-5">Story Reach</h2>
		<div class="row g-4 justify-content-center">
		<div class="col-md-4">
			<div class="p-4 rounded-4 bg-light shadow-sm h-100">
			<h3 class="counter mb-2" data-target="120">0</h3>
			<p class="text-uppercase small fw-bold tracking-wider">Stories Shared</p>
			</div>
		</div>
		<div class="col-md-4">
			<div class="p-4 rounded-4 bg-light shadow-sm h-100">
			<h3 class="counter mb-2" data-target="980">0</h3>
			<p class="text-uppercase small fw-bold tracking-wider">Girls Impacted</p>
			</div>
		</div>
		<div class="col-md-4">
			<div class="p-4 rounded-4 bg-light shadow-sm h-100">
			<h3 class="counter mb-2" data-target="22">0</h3>
			<p class="text-uppercase small fw-bold tracking-wider">Communities Reached</p>
			</div>
		</div>
		</div>
	</div>
	</section>

	<!-- CTA -->
	<section class="py-5 cta-section text-center">
	<div class="container">
		<h2 class="text-pink mb-3">Have a story to share?</h2>
		<a href="/contact" class="btn btn-pink">Share Your Story</a>
	</div>
	</section>

	<!-- Story Modal -->
	<div class="modal fade" id="storyModal" tabindex="-1" aria-labelledby="storyModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-dialog-centered">
		<div class="modal-content">
		<div class="modal-header">
			<h5 class="modal-title" id="storyModalLabel">Story Title</h5>
			<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
		</div>
		<div class="modal-body text-start">
			<p id="storyFullText">Full story text here.</p>
		</div>
		</div>
	</div>
	</div>

	<Footer />

</Layout>
