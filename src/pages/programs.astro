---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Our Programs | MGCE">
	<Navbar />

	 <!-- Hero Section -->
	 <section class="hero about-hero text-center text-white d-flex align-items-center justify-content-center">
		<video autoplay muted loop playsinline class="hero-video">
		   <source src="/assets/video/g5.mp4" type="video/mp4">
		   Your browser does not support the video tag.
		</video> 
		<div class="hero-overlay"></div>
		<div class="container" style="z-index: 2; position: relative;">
		   <h1 class="display-4 fw-bold">Our Programs</h1>
		   <p class="lead">Empowering girls through mentorship, leadership, and community action</p>
		 </div>
	   </section>
	 
	   <!-- Filter Buttons -->
	   <section class="py-4 text-center filter-section" aria-label="Program Category Filters">
		 <div class="container">
		   <button class="btn btn-outline-primary filter-btn active" data-filter="all">All</button>
		   <button class="btn btn-outline-primary filter-btn" data-filter="mentorship">Mentorship</button>
		   <button class="btn btn-outline-primary filter-btn" data-filter="leadership">Leadership</button>
		   <button class="btn btn-outline-primary filter-btn" data-filter="health">Health</button>
		   <button class="btn btn-outline-primary filter-btn" data-filter="education">Education</button>
		 </div>
	   </section>
	 
	   <!-- Program Cards -->
	   <section class="py-5 program-grid" aria-label="Program Listings">
		 <div class="container">
		   <div class="row g-4" id="programContainer">
			 <!-- Cards injected by JS -->
		   </div>
		 </div>
	   </section>
	 
	   <!-- Impact Counters -->
	   <section class="py-5 text-center bg-white impact-section shadow-sm" aria-label="Impact Statistics">
		 <div class="container py-4">
		   <h2 class="text-pink mb-4 display-5">Our Reach</h2>
		   <div class="row g-4 justify-content-center">
			 <div class="col-md-4">
				<div class="p-4 rounded-4 bg-light shadow-sm h-100">
			   <h3 class="counter mb-2" data-target="980">0</h3>
			   <p class="text-uppercase small fw-bold tracking-wider">Girls Mentored</p>
				</div>
			 </div>
			 <div class="col-md-4">
				<div class="p-4 rounded-4 bg-light shadow-sm h-100">
			   <h3 class="counter mb-2" data-target="35">0</h3>
			   <p class="text-uppercase small fw-bold tracking-wider">Programs Run</p>
				</div>
			 </div>
			 <div class="col-md-4">
				<div class="p-4 rounded-4 bg-light shadow-sm h-100">
			   <h3 class="counter mb-2" data-target="15">0</h3>
			   <p class="text-uppercase small fw-bold tracking-wider">Communities Reached</p>
				</div>
			 </div>
		   </div>
		 </div>
	   </section>
	 
	   <!-- Quote Carousel -->
	   <section class="py-5 quote-carousel text-center" aria-label="Testimonials">
		 <div class="container">
		   <h2 class="text-pink mb-4">What Girls Say</h2>
		   <p id="quoteDisplay" class="lead">“MGCE changed my life.”</p>
		 </div>
	   </section>
	 
	   <!-- Program Reach Map -->
	 <section class="py-5 map-section text-center" aria-label="Geographic Reach">
	   <div class="container">
		 <h2 class="text-pink mb-4">Where We Work</h2>
	 <iframe src="https://www.google.com/maps/d/embed?mid=1sCrDTWEUOrexJSVKLz_3e0kxrQOB27E&ehbc=2E312F&noprof=1" width="100%" height="480" style="max-width: 800px; border:0;"></iframe>    <p class="mt-3">Our programs have reached Kisumu, Siaya, Vihiga, Kakamega, and beyond.</p>
	   </div>
	 </section>
	 
	 
	   <!-- Call to Action -->
	   <section class="py-5 cta-section text-center" aria-label="Partner Invitation">
		 <div class="container">
		   <h2 class="text-pink mb-3">Want to bring a program to your community?</h2>
		   <a href="/contact" class="btn btn-pink">Partner With Us</a>
		 </div>
	   </section>
	 
	   <!-- Program Modal -->
	   <div class="modal fade" id="programModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
		 <div class="modal-dialog modal-lg modal-dialog-centered">
		   <div class="modal-content">
			 <div class="modal-header">
			   <h5 class="modal-title" id="modalTitle">Program Title</h5>
			   <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			 </div>
			 <div class="modal-body text-start">
			   <p id="modalDesc">Full description here.</p>
			   <ul id="modalGoals"></ul>
			   <a href="#" class="btn btn-outline-primary mt-3" id="modalDownload" target="_blank">Download Brief</a>
			 </div>
		   </div>
		 </div>
	   </div>

	<Footer />

</Layout>
